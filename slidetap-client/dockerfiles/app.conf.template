upstream slidetap_api {
  server appservice:${SLIDETAP_APIPORT};
}

server {
  listen ${SLIDETAP_PORT} ssl default_server;

  ssl_certificate /certs/${SLIDETAP_SSL_CERTIFICATE};
  ssl_certificate_key /certs/${SLIDETAP_SSL_CERTIFICATE_KEY};

  ssl_protocols TLSv1.2 TLSv1.3;

  proxy_ssl_session_reuse on;

  server_name  ${SLIDETAP_SERVERNAME};
  server_tokens off;

  # Inherited by every location below, as none adds headers of its own.
  include /etc/nginx/snippets/security-headers.conf;

  # Proxy settings for the /api locations. Like add_header, proxy_set_header is
  # only inherited by locations that set none of their own. This is the edge
  # proxy, so client-supplied forwarding headers are replaced, not appended to.
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host ${SLIDETAP_SERVERNAME}:${SLIDETAP_PORT};
  # Metadata uploads and their processing can take minutes.
  proxy_read_timeout 300s;
  proxy_send_timeout 300s;

  location / {
    root   /app;
    index  index.html;
    try_files $uri $uri/ /index.html;

  }
  error_page   500 502 503 504  /50x.html;
  location = /50x.html {
    root   /usr/share/nginx/html;
  }

  # Metadata file upload is the only large-body endpoint.
  location ~ ^/api/batches/batch/[^/]+/uploadFile$ {
    client_max_body_size 100M;
    proxy_pass http://slidetap_api;
  }

  location ~ ^/(api) {
    proxy_pass http://slidetap_api;
  }
}
